# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase configuration (Server and Client)
# Project URL (public)
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
# Publishable anon key (safe for client)
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."
# Supabase Service Role Secret Key (server-side only, never exposed to client)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Single-Owner Authentication Secret Password/Pin (Optional override, defaults to secure local session)
OWNER_PASSCODE="clipgenius-owner-2026"
SESSION_SECRET="super-secret-session-key"
